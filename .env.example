ENVIRONMENT=development
# With docker compose, MYSQL_HOST is overridden to "db" automatically
MYSQL_HOST=localhost
MYSQL_USER=root
# Must be non-empty when using docker compose (becomes MYSQL_ROOT_PASSWORD)
MYSQL_PASSWORD=
MYSQL_DATABASE=project3
SESSION_SECRET_KEY=change-me-to-a-random-secret
PASSWORD_SALT=change-me-to-original-salt
